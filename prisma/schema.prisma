// Prisma schema for Miracle Feng Shui
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  COD_PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses        Address[]
  orders           Order[]
  reviews          Review[]
  cart             Cart?
  favorites        Favorite[]
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  @@index([email])
  @@index([resetToken])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  image       String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
}

model Product {
  id                    String      @id @default(cuid())
  title                 String
  slug                  String      @unique
  description           String
  price                 Float
  comparePrice          Float?
  discount              String?
  images                String[]
  stock                 Int         @default(50)
  categoryId            String
  category              Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags                  String[]
  maker                 String      @default("Miracle Feng Shui Studio")
  makerAvatar           String?
  makerSales            Int         @default(0)
  starSeller            Boolean     @default(false)
  bestseller            Boolean     @default(false)
  etsyPick              Boolean     @default(false)
  freeShipping          Boolean     @default(true)
  itemDetails           String[]
  materials             String[]
  variations            Json?
  allowsPersonalization Boolean     @default(false)
  personalizationPrompt String?
  inDemandCount         Int         @default(0)
  isFeatured            Boolean     @default(false)
  isActive              Boolean     @default(true)
  ratingAvg             Float       @default(5.0)
  ratingCount           Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  cartItems             CartItem[]
  orderItems            OrderItem[]
  reviews               Review[]
  favorites             Favorite[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([slug])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id                  String   @id @default(cuid())
  cartId              String
  cart                Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity            Int      @default(1)
  selectedVariations  Json?
  personalizationText String?
  isGift              Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status            OrderStatus   @default(PENDING)
  paymentMethod     PaymentMethod @default(RAZORPAY)
  paymentStatus     PaymentStatus @default(PENDING)
  total             Float
  shippingAddress   Json
  razorpayOrderId   String?
  razorpayPaymentId String?
  courier           String?
  trackingNumber    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items             OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  title               String
  price               Float
  quantity            Int
  image               String
  selectedVariations  Json?
  personalizationText String?
  createdAt           DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Review {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating           Int
  comment          String
  productVariation String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

model HomepageSection {
  id         String   @id @default(cuid())
  sectionKey String   @unique
  name       String
  title      String
  subtitle   String?
  ctaText    String?
  ctaLink    String?
  badge      String?
  order      Int      @default(0)
  enabled    Boolean  @default(true)
  config     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sectionKey])
  @@index([order])
}
